# MatchForge Environment Configuration Example
DEBUG=True
SECRET_KEY=matchforge-production-insecure-secret-key-change-in-prod-xyz123
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave empty for SQLite local fallback, or provide PostgreSQL)
# DATABASE_URL=postgresql://matchforge_user:matchforge_pass@localhost:5432/matchforge_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True

# AI Services (Optional - Falls back to deterministic rule-based NLP if not provided)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto

# Security & CORS
CORS_ALLOW_ALL_ORIGINS=True
